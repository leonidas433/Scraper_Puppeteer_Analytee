# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite local (development)
DATABASE_URL=sqlite:///./data/analytics.db

# PostgreSQL (production) - uncomment and configure
# DATABASE_URL=postgresql://user:password@localhost:5432/analytics_db

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
# Ruta de datos scrapeados
SCRAPER_DATA_PATH=./data

# Ruta de reportes y outputs
ANALYTICS_OUTPUT_PATH=./reports

# Ruta de logs
LOGS_PATH=./logs

# ============================================================================
# API & DASHBOARD
# ============================================================================
# Puerto para FastAPI (si se implementa)
API_PORT=8000

# Host para API
API_HOST=0.0.0.0

# Url base del dashboard Streamlit
DASHBOARD_URL=http://localhost:8501

# ============================================================================
# ANALYSIS PARAMETERS
# ============================================================================
# Período por defecto para análisis (días)
DEFAULT_ANALYSIS_PERIOD_DAYS=30

# Activar análisis automático cada X minutos
AUTO_ANALYSIS_INTERVAL_MINUTES=60

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# Guardar logs en archivo
LOG_TO_FILE=true

# Máximo tamaño de archivo de log (MB)
LOG_MAX_SIZE_MB=50

# ============================================================================
# OPENAI (opcional, para análisis avanzados)
# ============================================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Modelo a usar
OPENAI_MODEL=gpt-3.5-turbo

# Activar análisis con IA
USE_OPENAI_ANALYSIS=false

# ============================================================================
# PERFORMANCE
# ============================================================================
# Número de workers para procesamiento paralelo
NUM_WORKERS=4

# Tamaño de batch para carga a BD
BATCH_SIZE=100

# Habilitar caching en memoria
ENABLE_CACHE=true

# TTL del caché (segundos)
CACHE_TTL_SECONDS=3600

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Ambiente: development, staging, production
ENVIRONMENT=development

# Debug mode
DEBUG=true

# ============================================================================
# SLACK / NOTIFICATIONS (opcional)
# ============================================================================
# Webhook de Slack para alertas
SLACK_WEBHOOK_URL=

# Enviar alertas de anomalías
SEND_ALERTS=false
